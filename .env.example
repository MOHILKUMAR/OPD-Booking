# Frontend environment (copy to .env.local). Everything here is PUBLIC: it is bundled into the
# browser JavaScript. Never put secret keys, Razorpay secrets or service-role keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_HOSPITAL_SLUG=demo-hospital
VITE_PAYMENTS_ENABLED=false
VITE_APP_ENV=development
# Optional Cloudflare Turnstile site key (public). Leave empty for no CAPTCHA. Set it, deploy, and
# only then turn on Supabase Auth -> Attack Protection -> CAPTCHA (Turnstile) with the secret key.
# Cloudflare's always-pass test key for local development: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
